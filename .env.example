# Sanity project (PUBLIC, non-secret — safe to commit as example placeholders)
# Real values live in .env.local (gitignored). projectId/dataset are public.
# NO write/deploy/API token belongs in any NEXT_PUBLIC_ var or committed file.
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
# Optional — pinned ISO date; defaults to 2025-08-01 in sanity/env.ts if unset
NEXT_PUBLIC_SANITY_API_VERSION="2025-08-01"
